# Build estatico (npm run build:static / Vercel). Lido pelo Vite com --mode static.
# Um arquivo de modo em vez de "VITE_STATIC=1 vite build" porque o prefixo de variavel
# nao funciona no cmd do Windows, e isto evita uma dependencia como cross-env.
VITE_STATIC=1

# A midia dos exercicios vem do proprio repositorio pelo CDN do jsDelivr, em vez de subir no
# deploy: sao 6.554 fotos (49 MB), 6.554 clipes MP4 (172 MB) e 6.554 animacoes de lista (78 MB),
# e o .vercelignore continua sem enviar catalogue/ — o deploy fica so com o app.
#
# Apontar estas tres bases forca o modo "bundled" (lib/exercises.js), ou seja o catalogo inteiro
# com foto, clipe e animacao, exatamente como roda local. Fixe a tag/commit em vez de @main se
# quiser que uma mudanca no repositorio nao troque a midia do site publicado na hora.
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/Wilprogramando/academya@main/catalogue/media/still/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/Wilprogramando/academya@main/catalogue/media/clip/
VITE_ANIM_BASE=https://cdn.jsdelivr.net/gh/Wilprogramando/academya@main/catalogue/media/anim/
